# CampToCorp Environment Configuration
PROJECT_NAME=CampToCorp
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & Authentication
SECRET_KEY=camptocorp-super-secret-jwt-key-2026-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=camptocorp
# Or specify direct DATABASE_URL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/camptocorp
# For local SQLite development if PostgreSQL is unavailable:
DATABASE_URL=sqlite:///./camptocorp.db

# Redis & Celery Background Workers
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
